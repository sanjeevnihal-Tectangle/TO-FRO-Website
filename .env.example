# Copy to .env and fill in the keys from each carrier's developer portal.
# Leave a carrier blank to skip it.

DHL_API_KEY=

FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_SANDBOX=0

UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_SANDBOX=0

BLUEDART_CLIENT_ID=
BLUEDART_CLIENT_SECRET=
BLUEDART_LOGIN_ID=
BLUEDART_LICENSE_KEY=
BLUEDART_SANDBOX=0

# Delhivery One is read from mcp.json. This token is only for the older express API.
DELHIVERY_API_TOKEN=
DELHIVERY_SANDBOX=0

# Courier Wala Xpresion tracking. Leave blank to use the public customer tracking login.
COURIERWALA_USER_ID=
COURIERWALA_PASSWORD=
COURIERWALA_API_URL=https://xpresion.courierwalaexpress.in/api/v1/Tracking/Tracking
