# Copy to .env and fill in the keys from each carrier's developer portal.
# Leave a carrier blank to skip it.

DHL_API_KEY=

FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_SANDBOX=0

UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_SANDBOX=0

BLUEDART_CLIENT_ID=
BLUEDART_CLIENT_SECRET=
BLUEDART_LOGIN_ID=
BLUEDART_LICENSE_KEY=
BLUEDART_SANDBOX=0

# Delhivery One. The local server reads these from mcp.json when they are blank.
# The live site reads these from the host environment.
D1_CLIENT_ID=
D1_CLIENT_SECRET=
D1_AUTH_URL=
D1_REALM=
D1_CLIENT_CMS=
D1_MCP_URL=

# Older Delhivery express token. Leave blank when Delhivery One is configured.
DELHIVERY_API_TOKEN=
DELHIVERY_SANDBOX=0

# Shipway Experience (tracks orders pushed into your Shipway account, by order ID).
# Find these in Shipway: Menu > Settings > General Settings > UserName and Licence Key.
# Add the same two values to the live site's host environment (e.g. Vercel project settings).
SHIPWAY_USERNAME=
SHIPWAY_LICENCE_KEY=

# Courier Wala Xpresion tracking. Leave blank to use the public customer tracking login.
COURIERWALA_USER_ID=
COURIERWALA_PASSWORD=
COURIERWALA_API_URL=https://xpresion.courierwalaexpress.in/api/v1/Tracking/Tracking
